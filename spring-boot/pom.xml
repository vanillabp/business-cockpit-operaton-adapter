<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>businesscockpit-operaton-adapter-parent</artifactId>
    <version>0.9.0-SNAPSHOT</version>
  </parent>

  <artifactId>businesscockpit-operaton-adapter-spring-boot</artifactId>
  <name>VanillaBP Business Cockpit adapter for Operaton - Spring Boot</name>
  <description>Registers the Operaton half of the Business Cockpit extension on Spring Boot: the engine customizer installing the listeners, the wiring service, and one bridge bean per configured Operaton adapter id.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>businesscockpit-operaton-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>extensions-commons-spring-boot</artifactId>
    </dependency>
    <dependency>
      <!-- the engines this extension listens to: they are held per configured adapter id by
        the adapter's Spring Boot module, which is the only place the extension takes them from -->
      <groupId>io.vanillabp</groupId>
      <artifactId>operaton-adapter-spring-boot</artifactId>
    </dependency>
    <dependency>
      <!-- the platform's own registrar support, which answers which adapter ids of a type this
        application configured. The bean registrar asks it while beans are registered, before
        VanillaBpSettings exists as a bean. The platform's decision allows this one call. It
        arrives transitively as well, and is declared because the bean registrar compiles
        against it -->
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-spring-boot-integration</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the cockpit server the tests report to, shared with the other extension repositories -->
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>extensions-commons-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <!-- the parent's rule, without the Spring Boot integration. This module still declares
          it, and the comment at the dependency says why -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>an-extension-depends-on-the-extension-spi-alone</id>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes combine.self="override">
                    <exclude>io.vanillabp.adapter:migration-adapter:*:*:compile</exclude>
                    <exclude>io.vanillabp:vanillabp-adapter-spi:*:*:compile</exclude>
                    <exclude>io.vanillabp:vanillabp-quarkus-integration:*:*:compile</exclude>
                    <exclude>io.vanillabp.adapter:migration-adapter:*:*:provided</exclude>
                    <exclude>io.vanillabp:vanillabp-adapter-spi:*:*:provided</exclude>
                    <exclude>io.vanillabp:vanillabp-quarkus-integration:*:*:provided</exclude>
                    <exclude>io.vanillabp.adapter:migration-adapter:*:*:runtime</exclude>
                    <exclude>io.vanillabp:vanillabp-adapter-spi:*:*:runtime</exclude>
                    <exclude>io.vanillabp:vanillabp-quarkus-integration:*:*:runtime</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
